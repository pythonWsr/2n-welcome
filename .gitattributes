# 默认所有文本文件在仓库和检出时都用 LF
* text=auto eol=lf

# Windows 批处理脚本保持 CRLF，避免 cmd 解析问题
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 明确二进制文件，禁止换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.mov binary
*.avi binary
