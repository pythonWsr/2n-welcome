{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {"source": "/assets/*", "headers": [{"key": "Access-Control-Allow-Origin", "value": "*"}]},
    {"source": "/assets/model-transport/*", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/release.json", "headers": [{"key": "Cache-Control", "value": "no-cache"}, {"key": "Access-Control-Allow-Origin", "value": "*"}]}
  ]
}
