{
  head: '维护',
  title: '管理员指南：安装 Git',
  summary: 'Windows / macOS / Linux / Termux 各平台安装 Git，并配置 GitHub SSH 访问。',
  time: '2026-10-02',
  stamp: 'blank',
  author: ['flowerwsr'],

  main1: '本指南帮助新管理员在不同平台上安装 Git，并完成 GitHub 的 SSH 配置。',

  main2: '=== 参考资料 ===',
  main3: 'Git 官方下载页：https://git-scm.com/downloads',
  main4: 'Pro Git 中文版（免费）：https://git-scm.com/book/zh/v2',
  main5: 'GitHub 入门指南：https://docs.github.com/zh/get-started/getting-started-with-git',

  main6: '=== Windows ===',
  main7: '方式一（推荐）：从官网下载安装包。',
  file1: { type: 'url', src: 'https://git-scm.com/download/win', alt: '下载 Git for Windows' },
  main8: '方式二：使用 winget（Windows 10 及以上）。',
  main9: `{{code|PowerShell|"""winget install --id Git.Git -e --source winget"""}}`,
  main10: '安装完成后验证：',
  main11: `{{code|PowerShell|"""git --version"""}}`,

  main12: '=== macOS ===',
  main13: '方式一（推荐）：使用 Homebrew。',
  main14: `{{code|Bash|"""# 若尚未安装 Homebrew，先执行
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

# 安装 git
brew install git"""}}`,
  main15: '方式二：从官网下载安装包。',
  file2: { type: 'url', src: 'https://git-scm.com/download/mac', alt: '下载 Git for macOS' },
  main16: '验证：',
  main17: `{{code|Bash|"""git --version"""}}`,

  main18: '=== Linux ===',
  main19: '根据发行版选择对应命令：',
  main20: `{{code|Bash|"""# Debian / Ubuntu
sudo apt update
sudo apt install git

# Fedora
sudo dnf install git

# Arch / Manjaro
sudo pacman -S git"""}}`,
  main21: '验证：',
  main22: `{{code|Bash|"""git --version"""}}`,

  main23: '=== Android · Termux ===',
  main24: 'Termux 是 Android 上的终端模拟器，可从 F-Droid 安装。',
  file3: { type: 'url', src: 'https://f-droid.org/packages/com.termux/', alt: '从 F-Droid 下载 Termux' },
  main25: '安装后运行以下命令：',
  main26: `{{code|Bash|"""# 更新包列表
pkg update
pkg upgrade

# 安装 git
pkg install git

# 验证
git --version"""}}`,

  main27: '=== 配置身份与 SSH ===',
  main28: '设置 Git 身份（提交时显示）：',
  main29: `{{code|Bash|"""git config --global user.name "你的用户名"
git config --global user.email "你的邮箱""""}}`,
  main30: '生成 SSH 密钥（一路回车即可）：',
  main31: `{{code|Bash|"""ssh-keygen -t ed25519 -C "你的邮箱"

# 查看并复制公钥内容
cat ~/.ssh/id_ed25519.pub"""}}`,
  main32: '将公钥内容粘贴到 GitHub → Settings → SSH and GPG keys。',
  file4: { type: 'url', src: 'https://github.com/settings/keys', alt: 'GitHub SSH 密钥设置' },
  main33: '测试连接：',
  main34: `{{code|Bash|"""ssh -T git@github.com"""}}`,
  main35: '看到 "Hi 用户名! You\'ve successfully authenticated" 即配置成功。',

  main36: '如有疑问，请在管理群提问。'
}
